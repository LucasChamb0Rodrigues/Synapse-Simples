# Copie este arquivo para .env e preencha. O .env NÃO vai para o GitHub (está no .gitignore).
# Na hospedagem (Railway, Render...), cadastre estas mesmas variáveis no painel em vez de usar o arquivo.

# Banco de dados MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=synapse_simples
# Banco na nuvem (ex.: Aiven): DB_SSL=true e cole em DB_SSL_CA o certificado CA do painel (-----BEGIN CERTIFICATE-----...)
DB_SSL=
DB_SSL_CA=
# Fuso horário das datas. Bancos na nuvem usam UTC; para horário de Brasília use -03:00
DB_TIMEZONE=

# Porta da API (a hospedagem costuma definir sozinha)
PORT=3000

# Frase longa e secreta para proteger o login. Gere uma com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Endereços do front-end que podem chamar a API (CORS), separados por vírgula.
# No computador: o Live Server do VS Code (porta 5500).
FRONTEND_URL=http://localhost:5500,http://127.0.0.1:5500

# true só em produção quando o front-end e a API ficam em domínios diferentes (exige HTTPS).
# Deixe vazio se a hospedagem do front repassa /api para a API (opção recomendada no README).
COOKIE_CROSS_SITE=
